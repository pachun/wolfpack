
<div class="player-details-<%= @player.id %> mt-6 flex flex-col items-center gap-4">
  <h1 class="text-3xl font-bold mb-6 text-gray-900 dark:text-gray-100">
    <%= "#{@player.first_name} #{@player.last_name}" %>
  </h1>

  <%= link_to "Edit", edit_player_path(@player), class: "inline-block px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded hover:bg-blue-700 transition" %>

  <%= button_to "Delete", player_path(@player),
      method: :delete,
      data: { confirm: "Are you sure you want to delete this player?" },
      class: "inline-block px-4 py-2 text-sm font-medium text-white bg-red-600 rounded hover:bg-red-700 transition" %>
</div>
